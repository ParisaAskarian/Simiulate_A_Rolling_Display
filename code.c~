#include <mega32.h>
#include <delay.h>
#asm
.equ __lcd_port=0x18;PORTB
#endasm
#include <lcd.h>

char text[] = "Parisa Askarian Kakh";
char line[16];

void shift_left(char line[16]){
    int i;

    for(i = 0; i < 15; i++)
    {
        line[i] = line[i+1];
    }

    line[15] = ' ';
}

void show_on_lcd(void){
    int i;

    lcd_gotoxy(0,0);

    for(i = 0; i < 16; i++)
    {
        lcd_putchar(line[i]);
    }
}

void finall_show(void){
    int i, j;

    lcd_init(16);

    for(j = 0; j < 16; j++){
        line[j] = ' '; 
    }
        
    while(1){
        for(i = 0; text[i] != '\0'; i++)
        {
            shift_left(line);

            line[15] = text[i];

            show_on_lcd();

            delay_ms(10);
        }

        for(i = 0; i < 16; i++)
        {
            shift_left(line);

            show_on_lcd();

            delay_ms(10);
        }
    }
}

void main(void)
{
    finall_show();    
    
}